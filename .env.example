# Day 6 pgvector (Docker, local only)
DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:55433/day6_lab

# Agent LLM: deepseek | openai | openrouter
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional: USD per 1M tokens from the provider pricing page; leave empty to report cost as null
DEEPSEEK_PRICE_INPUT_PER_M=
DEEPSEEK_PRICE_OUTPUT_PER_M=

OPENAI_API_KEY=
OPENROUTER_API_KEY=
