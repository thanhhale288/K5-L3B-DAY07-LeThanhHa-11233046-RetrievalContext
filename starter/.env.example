# Day 6 vector store:
# - Day 6 Docker Compose → 127.0.0.1:55433
# - Local Postgres (no Docker) → 127.0.0.1:5432
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Must match the Day 6 document index (BAAI/bge-m3, 1024-d, L2-normalized)
EMBEDDING_MODEL=BAAI/bge-m3
DAY6_STRATEGY=B

# Optional: absolute path to Day 6 repo (for export / rebuild helpers)
DAY6_REPO=/absolute/path/to/k5-l3b-day06-lethanhha-2a202603901-dataingestion

# Optional tool-calling LLM for the agent controller (leave empty to use heuristic controller)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=openai/gpt-4o-mini
